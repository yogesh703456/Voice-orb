[TEMPLATE]
# Copy this file to ".env" and fill in values. .env is git-ignored.
# Real environment variables always win over .env values.
#
# The default provider ("ollama") is LOCAL and needs NO key or .env file at
# all -- it talks to the Ollama app on this machine (127.0.0.1:11434).
# The entries below are only needed if you switch llm.provider to a cloud
# provider in config/settings.yaml.

# Anthropic (llm.provider: "anthropic")
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible endpoint (llm.provider: "openai-compatible")
OPENAI_API_KEY=

# Optional: only for a key-secured Ollama proxy. A stock local install
# needs nothing here.
# OLLAMA_API_KEY=
